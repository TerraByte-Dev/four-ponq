{
  "name": "four-player-pong",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "build:client": "tsc && vite build",
    "build:server": "tsc -p tsconfig.server.json && node -e \"require('fs').writeFileSync('dist-server/package.json', JSON.stringify({type:'commonjs'}))\"",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist-server/server/index.js"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "vite": "^6.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "playwright": "^1.59.1",
    "typescript": "^5.7.2"
  }
}
